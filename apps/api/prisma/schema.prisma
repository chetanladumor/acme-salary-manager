datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  HR_ADMIN
  HR_VIEWER
}

enum EmploymentStatus {
  ACTIVE     // Currently employed and active on payroll
  ON_LEAVE   // Extended leave (parental, medical, sabbatical); contract active
  INACTIVE   // Former employee who left the company (resigned/terminated); retained for audit & history
}

enum LeaveType {
  SICK
  CASUAL
  ANNUAL
  UNPAID
}

enum LeaveStatus {
  APPROVED
  PENDING
  REJECTED
}

enum ChangeReason {
  NEW_HIRE
  ANNUAL_REVIEW
  PROMOTION
  MARKET_ADJUSTMENT
  EQUITY_REALIGNMENT
  LATERAL_MOVE
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(HR_ADMIN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]

  @@map("users")
}

model Employee {
  id           String           @id @default(uuid())
  employeeCode String           @unique
  firstName    String
  lastName     String
  email        String           @unique
  country      String
  countryCode  String
  department   String
  jobTitle     String
  status       EmploymentStatus @default(ACTIVE)
  hireDate     DateTime
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Annual Leave Quotas (Total Entitlement per calendar year)
  sickLeaveQuota     Int              @default(10) @map("sick_leave_quota")
  casualLeaveQuota   Int              @default(12) @map("casual_leave_quota")
  annualLeaveQuota   Int              @default(15) @map("annual_leave_quota")

  // Current Remaining Balances
  sickLeaveBalance   Int              @default(10) @map("sick_leave_balance")
  casualLeaveBalance Int              @default(12) @map("casual_leave_balance")
  annualLeaveBalance Int              @default(15) @map("annual_leave_balance")

  salaryRecords        SalaryRecord[]
  payrollDisbursements PayrollDisbursement[]
  leaves               EmployeeLeave[]
  auditLogs            AuditLog[]

  @@index([country])
  @@index([department])
  @@index([jobTitle])
  @@index([status])
  @@index([lastName, firstName])
  @@map("employees")
}

model SalaryRecord {
  id                   String                @id @default(uuid())
  employeeId           String
  employee             Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  annualSalary         Decimal               @db.Decimal(12, 2)
  currency             String
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  reason               ChangeReason          @default(NEW_HIRE)
  createdBy            String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  payrollDisbursements PayrollDisbursement[]

  @@index([employeeId, effectiveFrom(sort: Desc)])
  @@index([currency, annualSalary])
  @@index([effectiveTo])
  @@map("salary_records")
}

model AuditLog {
  id         String    @id @default(uuid())
  actorId    String?
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([employeeId])
  @@index([actorId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model PayrollDisbursement {
  id              String        @id @default(uuid())
  employeeId      String        @map("employee_id")
  salaryRecordId  String?       @map("salary_record_id")
  month           Int
  year            Int
  payPeriod       String        @map("pay_period")
  payoutDate      DateTime      @map("payout_date")
  currency        String        @db.VarChar(3)

  grossSalary     Decimal       @db.Decimal(12, 2) @map("gross_salary")
  taxDeduction    Decimal       @default(0) @db.Decimal(12, 2) @map("tax_deduction")
  leaveDeduction  Decimal       @default(0) @db.Decimal(12, 2) @map("leave_deduction")
  otherDeductions Decimal       @default(0) @db.Decimal(12, 2) @map("other_deductions")
  totalDeductions Decimal       @default(0) @db.Decimal(12, 2) @map("total_deductions")
  netSalary       Decimal       @db.Decimal(12, 2) @map("net_salary")

  paidLeaveDays   Int           @default(0) @map("paid_leave_days")
  unpaidLeaveDays Int           @default(0) @map("unpaid_leave_days")

  status          String        @default("PAID")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")

  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryRecord    SalaryRecord? @relation(fields: [salaryRecordId], references: [id], onDelete: SetNull)

  @@index([employeeId, payoutDate(sort: Desc)])
  @@index([year, month])
  @@map("payroll_disbursements")
}

model EmployeeLeave {
  id          String      @id @default(uuid())
  employeeId  String      @map("employee_id")
  leaveType   LeaveType   @map("leave_type")
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  daysCount   Int         @map("days_count")
  isPaid      Boolean     @default(true) @map("is_paid")
  status      LeaveStatus @default(APPROVED)
  reason      String?
  month       Int         // 1 - 12
  year        Int
  createdAt   DateTime    @default(now()) @map("created_at")

  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, year, month])
  @@index([startDate, endDate])
  @@map("employee_leaves")
}
