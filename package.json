    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "keywords": [
    "salary-management",
    "hris",
    "compensation-analytics",
    "monorepo",
    "express",
    "react",
    "postgresql",
    "prisma"
  ],
