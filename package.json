{
  "name": "acme-salary-manager",
  "version": "1.0.0",
  "private": true,
  "description": "High-performance employee compensation management and pay analytics system",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=apps/api",
